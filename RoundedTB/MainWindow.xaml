<ui:FluentWindow x:Class="RoundedTB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoundedTB"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:l="clr-namespace:RoundedTB"
        mc:Ignorable="d"
        Title="RoundedTB Revived"
        Width="718" Height="458"
        Background="#20808080"
        d:Background="DarkGray"
        Visibility="Hidden"
        Opacity="0.001"
        d:Opacity="1"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        ResizeMode="NoResize"
        >

    <!-- ================================================================
         布局说明(为什么这样写)

         原布局用「绝对 Margin + 固定 Height/Width」把每个控件钉在坐标上:
           Margin="0,210,53,0"、Width="202" Height="55"、Margin="108,19,0,0" …
         这在单一 DPI/单一语言下能对齐,但换了字号/DPI/翻译长度就会互相挤压、
         文字被裁(典型:RoundedTB Revived 在 486px 容器里按 FontSize=60 排版,
         实际宽约 510px,被水平裁掉)。

         现在改为弹性布局:
            1. 窗口固定 Width(保持原来的 718)+ SizeToContent="Height" —— 高度跟着
               内容走,宽度保持稳定。**切勿**改成 SizeToContent="WidthAndHeight":
               宽度自动时 WPF 视可用宽度为无限,TextWrapping 便不再换行,一行长文字
               会把窗口撑得极宽(关于/帮助窗口就是这么被撑宽的)。
            2. 所有控件用 Grid 的行列 + StackPanel 排列,不再用绝对 Margin 定位;
               控件宽度用 Auto/* 分配,不再写死 Width。
            3. 任务栏示意图整体包在 Viewbox 里:内部保留一套"设计坐标"(486x247),
               Viewbox 负责等比缩放。这样内部的数字是**比例**,不是绝对像素——
               任何 DPI/窗口尺寸下都不会裁切。
            4. 大字标题再套一层 Viewbox(StretchDirection=DownOnly):文字超出可用
               宽度时自动等比缩小,永远完整显示。
            5. 文字类控件不要用 Label(其模板 padding 会挤压文字),用 TextBlock
               并设 TextWrapping="Wrap";CheckBox 的 Content 也一律包 TextBlock,
               否则长文案不换行会被裁。

          改布局时请保持这个原则:新增控件用行列/StackPanel 排,不要写死
          坐标与尺寸;需要在固定画布内排版的,放进 Viewbox。
          ================================================================ -->

    <Window.Resources>
        <!-- 托盘右键菜单主题刷子:右键打开时按系统亮暗模式更新(亮色/暗色)。 -->
        <SolidColorBrush x:Key="TrayMenuBgBrush" Color="#FA202020"/>
        <SolidColorBrush x:Key="TrayMenuBorderBrush" Color="#FF3D3D3D"/>
        <SolidColorBrush x:Key="TrayMenuFgBrush" Color="#FFE8E8E8"/>
        <SolidColorBrush x:Key="TrayMenuHoverBrush" Color="#FF3D3D3D"/>
        <!-- WPFUI 风格的托盘右键菜单(圆角 + hover 高亮 + 勾选标记),颜色由上面的刷子按主题控制。 -->
        <Style x:Key="TrayContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="4" Margin="2">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrayMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TrayMenuFgBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="8,6" Margin="1">
                            <DockPanel>
                                <TextBlock x:Name="CheckMark" DockPanel.Dock="Left" Text="&#x2713;"
                                           Width="18" Visibility="Collapsed" Foreground="#FF8AB4F8"/>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource TrayMenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Name="TrayContextMenu" x:Key="TrayContextMenu" MouseEnter="ContextMenu_MouseEnter" Opened="TrayContextMenu_Opened"
                     Style="{StaticResource TrayContextMenuStyle}">
            <MenuItem x:Name="StartupCheckBox" Header="{l:Loc Menu_RunAtStartup}" IsCheckable="True"
                      Click="Startup_Clicked" Style="{StaticResource TrayMenuItemStyle}"/>
            <MenuItem x:Name="ShowMenuItem" Header="{l:Loc Menu_Show}" Click="ShowMenuItem_Click"
                      Style="{StaticResource TrayMenuItemStyle}"/>
            <MenuItem x:Name="ResetDefaultsMenuItem" Header="{l:Loc Menu_ResetDefaults}" Click="ResetToDefaults_Click"
                      Style="{StaticResource TrayMenuItemStyle}"/>
            <MenuItem x:Name="ExitMenuItem" Header="{l:Loc Menu_Exit}" Click="ExitMenuItem_Click"
                      Style="{StaticResource TrayMenuItemStyle}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 托盘图标:Hardcodet.NotifyIcon 的 TaskbarIcon(自带独立宿主窗口,菜单由它
             弹出——不依赖主窗口显示,因此无需启动时 Show/Hide 预热,消除启动闪窗;
             点击菜单外部由 Shell 自动关闭,不需要自实现的鼠标监控定时器)。 -->
        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="RoundedTB Revived"
                        ContextMenu="{StaticResource TrayContextMenu}"
                        TrayLeftMouseUp="TrayIcon_TrayLeftMouseUp"/>

        <ui:TitleBar x:Name="mainTitleBar" Grid.Row="0" Title="{l:Loc Main_Title}"
                     Icon="pack://application:,,,/RoundedTB.ico" ShowMaximize="False"/>

        <!-- 主体:两列(左=示意图与选项,右=数值设置),底部一整行按钮。
             列宽用 * / Auto:左列吃掉剩余空间,右列按内容自适应。 -->
        <Grid Grid.Row="1" Margin="14,4,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 左列:任务栏示意图 + 下方选项 ============ -->
            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 示意图:内部是一套 486x247 的设计坐标,由 Viewbox 等比缩放,
                     因此不再受窗口尺寸/DPI 影响,也不会裁切任何文字。 -->
                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,12">
                    <Grid Width="486" Height="247">
                        <Rectangle Stroke="#30242424" Fill="#20808080" RadiusX="5" RadiusY="5"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <!-- 任务栏段示意:用 5 列还原原版的真实比例与段间距 ——
                             列 = widgets(1*) | 间隙(0.8*) | applist(3.5*) | 间隙(0.8*) | tray(1*)
                             即原版 486px 容器里的 66 : 234 : 66 三段 + 各 55px 间隙。
                             段间距用**独立列**而非 Margin:这样它随窗口等比缩放,
                             换 DPI/缩放时不会出现"三段挤在一起"或间距失真。
                             代码负责切换可见性与跨列(见 UpdateUi):
                               居中动态   = widgets | applist | tray
                               左对齐动态 = [applist 跨前 3 列] | tray
                               简单模式   = [单段跨全部 5 列] -->
                        <Grid VerticalAlignment="Bottom" Margin="4,0,4,10" Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="3.5*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="widgetsRectStandIn" Grid.Column="0"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Click="widgetsRectStandIn_Click" Appearance="Secondary"/>
                            <ui:Button x:Name="taskbarRectStandIn" Grid.Column="2"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Click="taskbarRectStandIn_Click" Appearance="Primary"/>
                            <ui:Button x:Name="trayRectStandIn" Grid.Column="4"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Click="trayRectStandIn_Click" Appearance="Secondary"/>
                        </Grid>

                        <!-- 示意图内文字区:用 Grid 行把"标题"与"提示语"分开,
                             各自在自己的行内垂直居中,不再互相挤压。
                             标题套 Viewbox(仅缩小):宽度不够时等比缩小而不裁切;
                             提示语允许换行:长翻译/高 DPI 下自动折行,不会横向裁掉。 -->
                        <Grid VerticalAlignment="Center" Margin="10,8,10,50">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly"
                                     MaxWidth="462" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Label Content="RoundedTB Revived" FontFamily="Segoe UI Variable Display"
                                       FontWeight="SemiBold" FontSize="60" Opacity="0.75"/>
                            </Viewbox>
                            <TextBlock Grid.Row="1" Text="{l:Loc Main_ToBegin}" TextWrapping="Wrap"
                                       TextAlignment="Center" HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       FontFamily="Segoe UI Variable Display" FontWeight="SemiBold"
                                       FontSize="20" Opacity="0.75"/>
                        </Grid>
                    </Grid>
                </Viewbox>

                <!-- 选项勾选框:纵向排列。
                     注意:CheckBox 的 Content 直接用字符串不会换行,WPF-UI 4.x 的
                     模板又带 MinHeight/Padding,长文案(如"按下 alt+tab 或 win+tab 时,
                     恢复任务栏")在空间不足时会被裁掉。所以这里统一用 TextBlock 作为
                     Content 并允许换行 + 限制最大宽度,空间不够时折行而不是裁切。 -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Left">
                    <CheckBox x:Name="showSegmentsOnHoverCheckBox" Margin="0,0,0,6"
                              Checked="showSegmentsOnHoverCheckBox_Checked" Unchecked="showSegmentsOnHoverCheckBox_Unchecked">
                        <TextBlock Text="{l:Loc Main_ShowSegmentsOnHover}" TextWrapping="Wrap" MaxWidth="560"/>
                    </CheckBox>
                    <CheckBox x:Name="fillMaximisedCheckBox" Margin="0,0,0,6"
                              Checked="fillMaximisedCheckBox_Checked" Unchecked="fillMaximisedCheckBox_Unchecked">
                        <TextBlock Text="{l:Loc Main_FillOnMaximise}" TextWrapping="Wrap" MaxWidth="560"/>
                    </CheckBox>
                    <CheckBox x:Name="fillAltTabCheckBox" Margin="0,0,0,6">
                        <TextBlock Text="{l:Loc Main_FillOnTaskSwitch}" TextWrapping="Wrap" MaxWidth="560"/>
                    </CheckBox>
                    <CheckBox x:Name="compositionFixCheckBox" IsChecked="False"
                              Checked="compositionFixCheckBox_Checked">
                        <TextBlock Text="{l:Loc Main_CompositionCompat}" TextWrapping="Wrap" MaxWidth="560"/>
                    </CheckBox>
                    <CheckBox x:Name="centredCheckBox" Visibility="Hidden">
                        <TextBlock Text="{l:Loc Main_CentredTaskbar}" TextWrapping="Wrap" MaxWidth="560"/>
                    </CheckBox>
                </StackPanel>
            </Grid>

            <!-- ============ 右列:数值设置(圆角/边距/自动隐藏) ============ -->
            <!-- 右列用固定宽度(MaxWidth 限制)而不是 Auto + 内容决定:
                 输入框/滑块需要稳定的对齐基线,列宽随内容变化会左右抖动。
                 列内所有文字一律用 TextBlock(Label 的模板 padding 会挤压文字)。 -->
            <StackPanel Grid.Row="0" Grid.Column="1" Width="248" VerticalAlignment="Top">

                <!-- 圆角:滑块吃掉剩余宽度,输入框按内容自适应。
                     最上面叠了一个透明热区(分屏模式帮助),保持原有交互位置。 -->
                <Grid Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="cornerRadiusLabel" Text="{l:Loc Main_CornerRadius}"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="cornerRadiusSlider" Grid.Column="0" VerticalAlignment="Center"
                                    MinWidth="90" LargeChange="0" SmallChange="1" Focusable="False" Maximum="48"
                                    Orientation="Horizontal"
                                    Thumb.DragCompleted="cornerRadiusSlider_DragCompleted"
                                    ValueChanged="cornerRadiusSlider_ValueChanged"/>
                            <TextBox x:Name="cornerRadiusInput" Grid.Column="1" Margin="10,0,0,0" TextWrapping="NoWrap"
                                     Text="" Width="64" LostFocus="cornerRadiusInput_LostFocus"/>
                        </Grid>
                    </StackPanel>
                    <Button x:Name="splitHelpButton" Opacity="0.001" Content="{l:Loc Main_SplitHelpButton}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Width="140" MinHeight="30"
                            Click="splitHelpButton_Click" FontWeight="Normal" FontFamily="Segoe UI Semibold"
                            Visibility="Hidden"/>
                </Grid>

                <!-- 边距:2x2 网格(上/下/左/右),标签与输入框各占一行,不再用绝对偏移。 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="mTopLabel" Grid.Row="0" Grid.Column="0" Text="{l:Loc Main_TopMargin}"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock x:Name="mBottomLabel" Grid.Row="0" Grid.Column="1" Margin="10,0,0,4"
                               Text="{l:Loc Main_BottomMargin}" TextWrapping="Wrap"/>
                    <TextBox x:Name="mTopInput" Grid.Row="1" Grid.Column="0" Margin="0,0,0,6" TextWrapping="NoWrap"
                             Text="" LostFocus="mTopInput_LostFocus"/>
                    <TextBox x:Name="mBottomInput" Grid.Row="1" Grid.Column="1" Margin="10,0,0,6" TextWrapping="NoWrap"
                             Text="" LostFocus="mBottomInput_LostFocus"/>
                    <TextBlock x:Name="mLeftLabel" Grid.Row="2" Grid.Column="0" Text="{l:Loc Main_LeftMargin}"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock x:Name="mRightLabel" Grid.Row="2" Grid.Column="1" Margin="10,0,0,4"
                               Text="{l:Loc Main_RightMargin}" TextWrapping="Wrap"/>
                    <TextBox x:Name="mLeftInput" Grid.Row="3" Grid.Column="0" TextWrapping="NoWrap"
                             Text="" LostFocus="mLeftInput_LostFocus"/>
                    <TextBox x:Name="mRightInput" Grid.Row="3" Grid.Column="1" Margin="10,0,0,0" TextWrapping="NoWrap"
                             Text="" LostFocus="mRightInput_LostFocus"/>
                </Grid>

                <!-- 自动隐藏:标签 + 下拉框纵向排列。 -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{l:Loc Main_AutoHide}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <ComboBox x:Name="autoHideComboBox">
                        <ComboBoxItem Content="{l:Loc Main_AutoHideAlwaysShow}"/>
                        <ComboBoxItem Content="{l:Loc Main_AutoHideAlwaysHide}"/>
                    </ComboBox>
                </StackPanel>

                <!-- 模式选择:三个勾选框叠在同一格,代码按模式切换可见性,
                     因此不需要各自的绝对定位与固定宽度。 -->
                <Grid>
                    <CheckBox x:Name="dynamicCheckBox" Checked="dynamicCheckBox_Checked"
                              Unchecked="dynamicCheckBox_Unchecked">
                        <TextBlock Text="{l:Loc Main_DynamicMode}" TextWrapping="Wrap" MaxWidth="200"/>
                    </CheckBox>
                    <CheckBox x:Name="showTrayCheckBox" Visibility="Hidden">
                        <TextBlock Text="{l:Loc Main_ShowTraySegment}" TextWrapping="Wrap" MaxWidth="200"/>
                    </CheckBox>
                    <CheckBox x:Name="showWidgetsCheckBox" Visibility="Hidden">
                        <TextBlock Text="{l:Loc Main_ShowWidgetsSegment}" TextWrapping="Wrap" MaxWidth="200"/>
                    </CheckBox>
                </Grid>
            </StackPanel>

            <!-- ============ 分隔线 + 按钮行 ============ -->
            <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,10"
                       Height="1" Stroke="#4C909090" RadiusX="1" RadiusY="1.5" VerticalAlignment="Center"/>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <ui:Button x:Name="resetDefaultsButton" Appearance="Secondary" Content="{l:Loc Main_ResetDefaults}"
                           Margin="0,0,8,0" MinWidth="132" Click="ResetToDefaults_Click" FontWeight="Normal"/>
                <ui:Button x:Name="aboutButton" Appearance="Secondary" Content="{l:Loc Main_Help}"
                           Margin="0,0,8,0" MinWidth="96" Click="aboutButton_Click" FontWeight="Normal"/>
                <ui:Button x:Name="applyButton" Content="{l:Loc Main_Apply}"
                           MinWidth="96" Click="ApplyButton_Click" FontWeight="Normal"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
