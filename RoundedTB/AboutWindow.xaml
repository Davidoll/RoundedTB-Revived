<ui:FluentWindow x:Class="RoundedTB.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoundedTB"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:RoundedTB"
        mc:Ignorable="d"
        Background="#20808080"
        Title="{l:Loc About_Title}"
        Width="500" Height="616"
        Visibility="Visible" ResizeMode="NoResize" Opacity="1.001"
        WindowBackdropType="Mica" WindowCornerPreference="Round" ExtendsContentIntoTitleBar="True">

    <!-- 布局说明:与 MainWindow.xaml 同一套原则——Grid 行/列 + StackPanel 排列,
         不用绝对 Margin 定位、不给文字写死 Height(那样换 DPI/语言就会裁字)。
         窗口宽度固定 500(与原版一致),高度由 SizeToContent="Height" 按内容决定;
         正文区放在 ScrollViewer 里,内容再多也只是内部滚动,不会撑高或裁掉窗口。
         注意:不要改成 SizeToContent="WidthAndHeight" —— 宽度自动时 WPF 视可用宽度
         为无限,TextWrapping 不再换行,长文案会把窗口撑得极宽。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="aboutTitleBar" Grid.Row="0" Title="{l:Loc About_Title}"
                     Icon="pack://application:,,,/RoundedTB.ico" ShowMaximize="False"/>

        <!-- 横幅:等比填充,宽度跟随窗口(原来写死 Width=500 + 负 Margin)。 -->
        <Grid Grid.Row="1" Height="128" ClipToBounds="True">
            <Image x:Name="bannerMst" Visibility="Hidden" Opacity="0.8"
                   Source="res\HeadBanner.png" Stretch="UniformToFill"
                   HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <Image x:Name="bannerDev" Visibility="Hidden" Opacity="0.8"
                   Source="res\HeadBannerDev.png" Stretch="UniformToFill"
                   HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <Image x:Name="bannerCan" Visibility="Hidden" Opacity="0.8"
                   Source="res\HeadBannerCan.png" Stretch="UniformToFill"
                   HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Grid>

        <!-- 标题 + 副标题 + 说明:纵向 StackPanel,间距由 Margin 统一控制。 -->
        <Grid Grid.Row="2" Margin="14,8,14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="titleBlock" TextWrapping="Wrap" Text="{l:Loc About_Welcome}"
                       FontWeight="Normal" FontFamily="Segoe UI Semibold" FontSize="28" Opacity="0.795"/>
            <TextBlock Grid.Row="1" x:Name="subtitleBlock" TextWrapping="Wrap" Text="{x:Static local:ChannelInfo.Subtitle}"
                       FontWeight="Normal" FontFamily="Segoe UI Semibold" FontSize="22" Opacity="0.795"
                       Margin="0,4,0,0"/>

            <TextBlock Grid.Row="2" x:Name="bodyBlockMain" TextWrapping="Wrap" FontWeight="Normal"
                       FontFamily="Segoe UI SemiBold" FontSize="14" Text="{l:Loc About_Thanks}"
                       Margin="0,14,0,10"/>

            <!-- 折叠区:占满剩余高度(窗口固定 500x616,不需要 MaxHeight——
                 用 * 行吸收空间,内容多时内部滚动,不会裁切也不会撑大窗口)。 -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Expander x:Name="expander0" Header="{l:Loc About_WhatsNew}" FontSize="16"
                              FontFamily="Segoe UI Semibold" HorizontalAlignment="Stretch">
                        <TextBlock Margin="0,5,0,0" x:Name="bodyBlock0" TextWrapping="Wrap"
                                   FontWeight="Normal" FontFamily="Segoe UI" FontSize="14" Opacity="0.8"
                                   LineHeight="23" Text="{l:Loc About_WhatsNewBody}"/>
                    </Expander>
                    <Expander x:Name="expander1" Header="{l:Loc About_BasicOptions}" FontSize="16"
                              FontFamily="Segoe UI Semibold" HorizontalAlignment="Stretch">
                        <TextBlock Margin="0,5,0,0" x:Name="bodyBlock1" TextWrapping="Wrap"
                                   FontWeight="Normal" FontFamily="Segoe UI" FontSize="14" Opacity="0.8"
                                   LineHeight="23" Text="{l:Loc About_BasicOptionsBody}"/>
                    </Expander>
                    <Expander x:Name="expander2" Header="{l:Loc About_AdvancedOptions}" FontSize="16"
                              FontFamily="Segoe UI Semibold" HorizontalAlignment="Stretch">
                        <TextBlock Margin="0,5,0,0" x:Name="bodyBlock2" TextWrapping="Wrap"
                                   FontWeight="Normal" FontFamily="Segoe UI" FontSize="14" Opacity="0.8"
                                   LineHeight="23" Text="{l:Loc About_AdvancedOptionsBody}"/>
                    </Expander>
                    <Expander x:Name="expander3" Header="{l:Loc About_KnownIssues}" FontSize="16"
                              FontFamily="Segoe UI Semibold" HorizontalAlignment="Stretch">
                        <TextBlock Margin="0,5,0,0" x:Name="bodyBlock3" TextWrapping="Wrap"
                                   FontWeight="Normal" FontFamily="Segoe UI" FontSize="14" Opacity="0.8"
                                   LineHeight="23" Text="{l:Loc About_KnownIssuesBody}"/>
                    </Expander>
                    <Expander x:Name="expander4" Header="{l:Loc About_HelpInfo}" FontSize="16"
                              FontFamily="Segoe UI Semibold" HorizontalAlignment="Stretch">
                        <TextBlock Margin="0,5,0,0" x:Name="bodyBlock4" TextWrapping="Wrap"
                                   FontWeight="Normal" FontFamily="Segoe UI" FontSize="14" Opacity="0.8"
                                   LineHeight="21" Text="{l:Loc About_HelpInfoBody}"/>
                    </Expander>
                    <Expander x:Name="expander5" Header="{l:Loc About_Debug}" FontSize="16"
                              FontFamily="Segoe UI Semibold" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <Button x:Name="configButton" Content="{l:Loc About_OpenConfig}" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Click="configButton_Click"/>
                            <Button x:Name="logButton" Content="{l:Loc About_OpenLog}" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Click="logButton_Click"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 按钮行:按内容宽度自适应,不再写死 Width=85。 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,0,14,14">
            <Button x:Name="okButton" Content="{l:Loc About_Ok}" MinWidth="85"
                    Click="okButton_Click" FontWeight="Normal"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
