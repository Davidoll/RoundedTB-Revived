<Application x:Class="RoundedTB.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RoundedTB"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI 4.x:全局资源字典由库统一提供(1.x 时代的
                     Styles/Theme/Dark.xaml + Styles/WPFUI.xaml 双字典已合并为此一个)。
                     主题由 App.OnStartup 的 ApplicationThemeManager.Apply 按系统主题设置。 -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
